{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "input_fingerprint", "candidates", "residue"],
  "properties": {
    "protocol_version": {"type": "string", "const": "external-agent-handoff/1.0"},
    "input_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "semantic_type", "concerns", "evidence_unit_ids", "context", "confidence"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "semantic_type": {"type": "string", "enum": ["observation", "requirement", "judgment", "decision", "commitment", "action", "other"]},
          "concerns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence_unit_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "context": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "residue": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_unit_ids", "reason_not_absorbed", "future_value_or_uncertainty"],
        "properties": {
          "evidence_unit_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "reason_not_absorbed": {"type": "string", "minLength": 1},
          "future_value_or_uncertainty": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
